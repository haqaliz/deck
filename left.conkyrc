background no
use_xft yes
xftfont Sans:size=14
xftalpha 1
update_interval 1.0
total_run_times 0
own_window yes
own_window_transparent no
own_window_argb_visual yes
own_window_argb_value 0
own_window_type desktop
own_window_hints undecorated,below,sticky,skip_taskbar,skip_pager
double_buffer yes
minimum_size 500 200
maximum_width 500
draw_shades no
draw_outline no
draw_borders no
draw_graph_borders yes
default_color white
alignment top_left
gap_x 220
gap_y 80
no_buffers yes
uppercase no
cpu_avg_samples 2
override_utf8_locale no
mpd_host 127.0.0.1

TEXT
# WEATHER
${font sans-serif:bold:size=14}WEATHER ${hr 2}${font sans-serif:normal:size=14}
${font}Tehran${iconv_start UTF-8 ISO_8859-1}${alignr}${font}${execi 10 misc -w tehran:c}${iconv_stop}
${font}Toronto${iconv_start UTF-8 ISO_8859-1}${alignr}${font}${execi 10 misc -w toronto:c}${iconv_stop}

#
# ----------- DROPLET / PORTAL STAG -----------
${font sans-serif:bold:size=14}PORTAL STAG ${hr 2}${font sans-serif:normal:size=14}
### DISK USAGE
${font}/ =>${alignr}${execi 900 "misc -e portal-stag -x 'df -h' -f /"}${iconv_stop}
${font}/mnt/volume_tor1_04 =>${alignr}${execi 900 "misc -e portal-stag -x 'df -h' -f /mnt/volume_tor1_04"}${iconv_stop}

# ------------------ LOGS ---------------------
${font sans-serif:bold}${color red}Jobs Logs:
${font}${color white}${iconv_start UTF-8 ISO_8859-1}${execi 10 "misc -e portal-stag -x 'log' -f 'base=portal2-backend/logs,service=jobs'"}${iconv_stop}

${font sans-serif:bold}${color red}Winston Logs:
${font}${color white}${iconv_start UTF-8 ISO_8859-1}${execi 10 "misc -e portal-stag -x 'log' -f 'base=portal2-backend/logs,service=winston'"}${iconv_stop}

${font sans-serif:bold}${color red}Telemetry Logs:
${font}${color white}${iconv_start UTF-8 ISO_8859-1}${execi 10 "misc -e portal-stag -x 'log' -f 'base=portal2-backend/logs,service=telemetry'"}${iconv_stop}

# ----------- DROPLET / PORTAL PROD -----------
${font sans-serif:bold:size=14}PORTAL PROD ${hr 2}${font sans-serif:normal:size=14}
### DISK USAGE
${font}/ =>${alignr}${execi 900 "misc -e portal-prod -x 'df -h' -f /"}${iconv_stop}
${font}/mnt/volume_tor1_04 =>${alignr}${execi 900 "misc -e portal-prod -x 'df -h' -f /mnt/volume_tor1_05"}${iconv_stop}

# ------------------ LOGS ---------------------
${font sans-serif:bold}${color red}Jobs Logs:
${font}${color white}${iconv_start UTF-8 ISO_8859-1}${execi 10 "misc -e portal-prod -x 'log' -f 'base=portal2-backend/logs,service=jobs'"}${iconv_stop}

${font sans-serif:bold}${color red}Winston Logs:
${font}${color white}${iconv_start UTF-8 ISO_8859-1}${execi 10 "misc -e portal-prod -x 'log' -f 'base=portal2-backend/logs,service=winston'"}${iconv_stop}

${font sans-serif:bold}${color red}Telemetry Logs:
${font}${color white}${iconv_start UTF-8 ISO_8859-1}${execi 10 "misc -e portal-prod -x 'log' -f 'base=portal2-backend/logs,service=telemetry'"}${iconv_stop}

