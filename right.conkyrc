background no
use_xft yes
xftfont Sans:size=14
xftalpha 1
update_interval 1.0
total_run_times 0
own_window yes
own_window_transparent no
own_window_argb_visual yes
own_window_argb_value 0
own_window_type desktop
own_window_hints undecorated,below,sticky,skip_taskbar,skip_pager
double_buffer yes
minimum_size 500 200
maximum_width 500
draw_shades no
draw_outline no
draw_borders no
draw_graph_borders yes
default_color white
alignment top_right
gap_x 190
gap_y 80
no_buffers yes
uppercase no
cpu_avg_samples 2
override_utf8_locale no
mpd_host 127.0.0.1

TEXT
${font sans-serif:bold:size=14}SYSTEM ${hr 2}
${font sans-serif:normal:size=14}$sysname $kernel $alignr $machine
Host:$alignr$nodename
Uptime:$alignr$uptime

${font sans-serif:bold:size=14}PROCESSORS ${hr 2}
${font sans-serif:bold:size=14}${cpugraph cpu1 FF0000 00FF00}
CPU 1: ${font sans-serif:normal:size=14}${cpu cpu1} % ${cpubar cpu1}
${font sans-serif:bold:size=14}${cpugraph cpu2 FF0000 00FF00}
CPU 2: ${font sans-serif:normal:size=14}${cpu cpu2} % ${cpubar cpu2}

${font sans-serif:bold:size=14}MEMORY ${hr 2}
${font sans-serif:bold:size=14}RAM  ${font sans-serif:normal:size=14}$mem / $memmax  $membar
# ${font sans-serif:bold:size=14}SWAP  ${font sans-serif:normal:size=14}${swap} / ${swapmax} ${swapbar}

${font sans-serif:bold:size=14}DISKS ${hr 2}
${font sans-serif:normal:size=14}/ $alignc ${fs_used /} / ${fs_size /} $alignr ${fs_used_perc /}%
# ${fs_bar /}
# /home${font sans-serif:normal:size=14} $alignc ${fs_used /home} / ${fs_size /home} $alignr ${fs_used_perc /home}%
# ${fs_bar /home}
# External${font sans-serif:normal:size=14} $alignc ${fs_used /media/external} / ${fs_size /media/external} $alignr ${fs_used_perc /media/external}%
# ${fs_bar /media/external}

${font sans-serif:bold:size=14}TOP PROCESSES ${hr 2}
${font sans-serif:normal:size=14}${top_mem name 1}${alignr}${top mem 1} %
${top_mem name 2}${alignr}${top mem 2} %
${top_mem name 3}${alignr}${top mem 3} %
# ${top_mem name 4}${alignr}${top mem 4} %

# STATS
## TEMPERATURE
${font sans-serif:bold:size=14}STATS ${hr 2}${font sans-serif:normal:size=14}
### CPU
${iconv_start UTF-8 ISO_8859-1}CPU:${alignr}${font}${execi 10 misc -t cpu}
### GPU
GPU:${alignr}${font}${execi 10 misc -t gpu}
# HELPERS
## SPEED
Fan:${alignr}${font}${execi 10 misc --fan} RPM
## NETWORK
### HOSTNAME
Hostname:${alignr}${font}${execi 10 misc -n hostname}
### IP ADDRESS
IP Address:${alignr}${font}${execi 60 misc -n ip}
## BANDWIDTH
${if_match ${downspeedf wlp3s0} >= 0}Download: ${downspeedf wlp3s0} kB/s ${alignr} Upload: ${upspeedf wlp3s0} kB/s
${downspeedgraph wlp3s0 20,248 7fff00 ff0000 -t} ${upspeedgraph wlp3s0 20,248 7fff00 ff0000 -t}${endif}
${if_match ${downspeedf lo} >= 0}Download: ${downspeedf lo} kB/s ${alignr} Upload: ${upspeedf lo} kB/s
${downspeedgraph lo 20,248 7fff00 ff0000 -t} ${upspeedgraph lo 20,248 7fff00 ff0000 -t}${endif}

